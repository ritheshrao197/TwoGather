/**
 * @description This ruleset enforces access control for the 'Shared Spaces' application based on a space-centric model.
 * @dataStructure
 *   - /spaces/{spaceId}: Stores space-level information. Publicly readable if public_enabled, otherwise members only.
 *   - /spaces/{spaceId}/members/{memberId}: Stores participant information. Members of a space can see other members.
 *   - /spaces/{spaceId}/content/{contentId}: Stores content. Visibility is controlled by the 'visibility' field.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is a member of a given space.
    // This requires a read to the members subcollection.
    function isMember(spaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid));
    }

    match /spaces/{spaceId} {
      // Anyone can read a space document to check its public status.
      allow get: if true;
      // Listing all spaces is disallowed.
      allow list: if false;
      // Only authenticated users can create a space.
      allow create: if isSignedIn();
      // Only a member of the space can update it.
      allow update, delete: if isMember(spaceId);

      match /members/{memberId} {
        // A member can read their own data. Other members of the space can also read it.
        allow get: if isSignedIn() && (request.auth.uid == memberId || isMember(spaceId));
        // All members of a space can list the other members.
        allow list: if isMember(spaceId);
        // A user can create their own member document.
        // Also, an existing member can create a document for another member (e.g. for a partner).
        allow create: if isSignedIn() && (request.auth.uid == memberId || isMember(spaceId));
        // A member can update their own document.
        allow update: if isSignedIn() && request.auth.uid == memberId;
        // A member can delete their own document.
        allow delete: if isSignedIn() && request.auth.uid == memberId;
      }

      match /claimCodes/{claimCodeId} {
        // Claim codes can be read by members to facilitate the claim process.
        allow get, list: if isMember(spaceId);
        allow create, update, delete: if isMember(spaceId);
      }

      match /content/{contentId} {
        // Allow read if the content is public, or if the user is a member.
        allow get: if resource.data.visibility == 'public' || isMember(spaceId);
        // Allow list under the same conditions as get.
        allow list: if isMember(spaceId); // Simplified for now, client should filter public content.
        // A member can create content.
        allow create: if isMember(spaceId) && request.resource.data.authorMemberId == request.auth.uid;
        // The author can update or delete their content.
        allow update, delete: if isMember(spaceId) && resource.data.authorMemberId == request.auth.uid;
      }
    }
  }
}

    