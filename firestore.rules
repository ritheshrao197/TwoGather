
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      // In this simplified flow, authentication is handled client-side.
      // We assume if a user is trying to access a sub-collection, they are authorized.
      return true;
    }

    match /spaces/{spaceId} {
      // Anyone can create or read a space's top-level info.
      allow read, create: if true;
      // Updates are allowed, trusting client-side logic.
      allow update, delete: if true;

      match /members/{memberId} {
        // Members of a space can be read by anyone who has access to the space.
        allow read, list, create, update, delete: if isSignedIn();
      }

      match /content/{contentId} {
        // All content operations are allowed for authorized users.
        allow read, list, create, update, delete: if isSignedIn();
      }
      
      match /games/{gameId} {
        // Game state can be read and written by authorized users.
        allow read, write: if isSignedIn();
      }

      match /pendingMessages/{messageId} {
        // Pending messages can be managed by authorized users.
        allow read, list, create, delete: if isSignedIn();
      }
    }
  }
}
