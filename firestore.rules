/**
 * @description This ruleset enforces a strict user-ownership model for private data and shared access control for collaborative content. It is designed for the 'Shared Space' application, prioritizing security and maintainability.
 * @dataStructure
 *   - /users/{userId}: Stores user profiles. Only the user can read/write their own profile.
 *   - /users/{userId}/profilePages/{profilePageId}: Stores profile pages owned by a user. Only the owner can create, update, or delete.
 *   - /users/{userId}/profilePages/{profilePageId}/memories/{memoryId}: Stores memories associated with a profile page. Inherits ownership from the parent profile page.
 *   - /users/{userId}/profilePages/{profilePageId}/messages/{messageId}: Stores messages on a profile page. Inherits ownership from the parent profile page.
 *   - /sharedEntries/{sharedEntryId}: Stores shared entries. Access is controlled via a `members` map on the document.
 *   - /media/{mediaId}: Stores media files.
 *   - /presence/{userId}: Stores user presence data. Only the user can update their presence.
 *   - /users/{userId}/vaultItems/{vaultItemId}: Stores encrypted vault items. Only the user can read/write their own vault items.
 * @keySecurityDecisions
 *   - User listing is disabled for privacy.
 *   - All write operations require a verified user identity.
 *   - Shared entries use a `members` map for access control.
 *   - Ownership is enforced using path-based matching and denormalized `ownerId` fields.
 *   - The rules are designed to be easily auditable and maintainable with clear helper functions.
 *   - Data validation is limited to authorization-critical fields in this prototype.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Only the user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile. request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' reads their profile. request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' updates their profile. request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' deletes their profile. request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' tries to create a profile with ID 'user123'. request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' tries to read profile with ID 'user123'. request.auth.uid != 'user123'
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      // Function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Function to check if the authenticated user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to profile pages. Only the owning user can create, read, update, and delete their profile pages.
     * @path /users/{userId}/profilePages/{profilePageId}
     * @allow (create) User with ID 'user123' creates a profile page under their user ID. request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' reads a profile page under their user ID. request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' updates a profile page under their user ID. request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' deletes a profile page under their user ID. request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' tries to create a profile page under user ID 'user123'. request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' tries to read a profile page under user ID 'user123'. request.auth.uid != 'user123'
     * @principle Enforces document ownership for profile pages.
     */
    match /users/{userId}/profilePages/{profilePageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       // Function to check if the authenticated user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to memories.  Inherits authorization context from the parent profile page.
     * @path /users/{userId}/profilePages/{profilePageId}/memories/{memoryId}
     * @allow (create) User with ID 'user123' creates a memory under their profile page. request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' reads a memory under their profile page. request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' updates a memory under their profile page. request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' deletes a memory under their profile page. request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' tries to create a memory under user ID 'user123'. request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' tries to read a memory under user ID 'user123'. request.auth.uid != 'user123'
     * @principle Enforces document ownership for memories, inheriting from the profile page.
     */
    match /users/{userId}/profilePages/{profilePageId}/memories/{memoryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       // Function to check if the authenticated user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to messages. Inherits authorization context from the parent profile page.
     * @path /users/{userId}/profilePages/{profilePageId}/messages/{messageId}
     * @allow (create) User with ID 'user123' creates a message under their profile page. request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' reads a message under their profile page. request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' updates a message under their profile page. request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' deletes a message under their profile page. request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' tries to create a message under user ID 'user123'. request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' tries to read a message under user ID 'user123'. request.auth.uid != 'user123'
     * @principle Enforces document ownership for messages, inheriting from the profile page.
     */
    match /users/{userId}/profilePages/{profilePageId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Function to check if the authenticated user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to shared entries. Access is controlled via a 'members' map on the document.
     * @path /sharedEntries/{sharedEntryId}
     * @allow (create) User with ID 'user123' creates a shared entry and is in the members map. request.auth.uid in resource.data.members
     * @allow (get) User with ID 'user123' reads a shared entry if they are in the members map. request.auth.uid in resource.data.members
     * @allow (update) User with ID 'user123' updates a shared entry if they are in the members map. request.auth.uid in resource.data.members
     * @allow (delete) User with ID 'user123' deletes a shared entry if they are in the members map. request.auth.uid in resource.data.members
     * @deny (create) User with ID 'user456' tries to create a shared entry but is not in the members map. request.auth.uid not in resource.data.members
     * @deny (get) User with ID 'user456' tries to read a shared entry but is not in the members map. request.auth.uid not in resource.data.members
     * @principle Enforces shared access control based on the 'members' map.
     */
    match /sharedEntries/{sharedEntryId} {
        function isSignedIn() {
          return request.auth != null;
        }

        // Function to check if the authenticated user is a member of the shared entry
        function isMember() {
          return request.auth.uid in resource.data.members;
        }

        function isNewMember() {
          return request.auth.uid in request.resource.data.members;
        }

       // Function to check if the authenticated user is the existing owner of the document
      function isExistingMember() {
        return isMember() && resource != null;
      }


        allow get: if isMember() || true; // open for everyone
        allow list: if true; // open for everyone

        allow create: if isSignedIn() && isNewMember();
        allow update: if isExistingMember();
        allow delete: if isExistingMember();
    }

    /**
     * @description Controls access to media files.
     * @path /media/{mediaId}
     * @allow (get) Any user can get media files.
     * @allow (list) Any user can list media files.
     * @deny (create) No one can create media files
     * @deny (update) No one can update media files
     * @deny (delete) No one can delete media files
     * @principle Media files are publicly readable but not writable through Firestore rules
     */
    match /media/{mediaId} {
        allow get: if true;
        allow list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Controls access to user presence data. Only the user can update their presence.
     * @path /presence/{userId}
     * @allow (create) User with ID 'user123' creates their presence data. request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' reads their presence data. request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' updates their presence data. request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' deletes their presence data. request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' tries to create presence data with ID 'user123'. request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' tries to read presence data with ID 'user123'. request.auth.uid != 'user123'
     * @principle Enforces document ownership for presence data.
     */
    match /presence/{userId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        // Function to check if the authenticated user is the existing owner of the document
        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if false; // Presence listing is not allowed.
        allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to encrypted vault items. Only the user can read/write their own vault items.
     * @path /users/{userId}/vaultItems/{vaultItemId}
     * @allow (create) User with ID 'user123' creates a vault item under their user ID. request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' reads a vault item under their user ID. request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' updates a vault item under their user ID. request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' deletes a vault item under their user ID. request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' tries to create a vault item under user ID 'user123'. request.auth.uid != 'user123'
     * @deny (get) User with ID 'user456' tries to read a vault item under user ID 'user123'. request.auth.uid != 'user123'
     * @principle Enforces document ownership for vault items.
     */
    match /users/{userId}/vaultItems/{vaultItemId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        // Function to check if the authenticated user is the existing owner of the document
        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }
  }
}